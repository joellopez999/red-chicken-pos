#!/bin/bash
# Abre la plataforma Red Chicken POS y su panel de control, cada uno en su
# propia pestaña; arranca el servicio del panel si no está corriendo.
set -e

if ! systemctl --user is-active --quiet pos-dashboard.service; then
  systemctl --user start pos-dashboard.service
  sleep 1
fi

xdg-open "https://pos.redchickenec.com" >/dev/null 2>&1 &
xdg-open "http://127.0.0.1:8090" >/dev/null 2>&1 &
